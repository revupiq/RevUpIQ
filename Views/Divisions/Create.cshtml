@model RevUpIQ.Admin.Models.Division.DivisionCreateViewModel
@{
    ViewData["Title"] = "Create Division";
}

<div style="display:flex;
            justify-content:center;
            margin-top:60px;">

    <div style="width:420px;">

        <h1 class="admin-title" style="text-align:center;">
            Create Division
        </h1>

        <form asp-controller="Divisions"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @if (ViewData["Error"] is string error)
            {
                <div role="alert"
                     style="margin-bottom:16px; padding:10px 12px; border:1px solid #c0392b; border-radius:8px; color:#ffb3b3;">
                    @error
                </div>
            }

            <div style="margin-bottom:16px;">
                <input type="text"
                       id="divisionName"
                       name="Name"
                       value="@Model?.Name"
                       class="admin-input"
                       placeholder="Division Name"
                       required />
            </div>

            <div style="margin-bottom:16px;">
                <label for="divisionLogo"
                       style="display:block; margin-bottom:6px; font-size:14px; opacity:0.8;">
                    Division Logo (required) — shown in the app's division menu
                </label>
                <input type="file"
                       id="divisionLogo"
                       name="Logo"
                       class="admin-input"
                       accept="image/*"
                       required />
            </div>

            <div style="margin-bottom:16px;">
                <label for="divisionPurchaseIcon"
                       style="display:block; margin-bottom:6px; font-size:14px; opacity:0.8;">
                    Purchase Page Icon (optional) — shown on the app's purchase page
                </label>
                <input type="file"
                       id="divisionPurchaseIcon"
                       name="PurchaseIcon"
                       class="admin-input"
                       accept="image/*" />
            </div>

            <fieldset style="margin:0 0 16px 0; padding:12px 14px; border:1px solid var(--mid-dark-blue); border-radius:8px;">
                <legend style="padding:0 6px; font-size:14px; opacity:0.8;">
                    Store IDs (optional) — used for the division's subscription
                </legend>
                <p style="margin:0 0 12px 0; font-size:13px; opacity:0.7;">
                    Filled in from the name. They must match the IDs in Google Play Console and
                    App Store Connect. You can change them later on the division page.
                </p>

                <label for="googleProductId"
                       style="display:block; margin-bottom:6px; font-size:14px; opacity:0.8;">
                    Google Play subscription ID
                </label>
                <input type="text"
                       id="googleProductId"
                       name="GoogleProductId"
                       value="@Model?.GoogleProductId"
                       class="admin-input store-id-input"
                       data-suffix="_sub"
                       placeholder="e.g. pavement_sub"
                       autocomplete="off"
                       style="margin-bottom:12px;" />

                <label for="appleProductIdMonthly"
                       style="display:block; margin-bottom:6px; font-size:14px; opacity:0.8;">
                    App Store monthly product ID
                </label>
                <input type="text"
                       id="appleProductIdMonthly"
                       name="AppleProductIdMonthly"
                       value="@Model?.AppleProductIdMonthly"
                       class="admin-input store-id-input"
                       data-suffix="_monthly"
                       placeholder="e.g. pavement_monthly"
                       autocomplete="off"
                       style="margin-bottom:12px;" />

                <label for="appleProductIdAnnual"
                       style="display:block; margin-bottom:6px; font-size:14px; opacity:0.8;">
                    App Store annual product ID
                </label>
                <input type="text"
                       id="appleProductIdAnnual"
                       name="AppleProductIdAnnual"
                       value="@Model?.AppleProductIdAnnual"
                       class="admin-input store-id-input"
                       data-suffix="_annual"
                       placeholder="e.g. pavement_annual"
                       autocomplete="off" />
            </fieldset>

            <button type="submit"
                    id="submitBtn"
                    class="admin-button"
                    style="width:100%; opacity:0.5;"
                    disabled>
                Create Division
            </button>

        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const nameInput = document.getElementById("divisionName");
        const logoInput = document.getElementById("divisionLogo");
        const submitBtn = document.getElementById("submitBtn");

        if (!nameInput || !logoInput || !submitBtn) {
            return;
        }

        function toggleButton() {
            const hasName = nameInput.value.trim() !== "";
            const hasLogo = logoInput.files.length > 0;

            submitBtn.disabled = !(hasName && hasLogo);
            submitBtn.style.opacity = submitBtn.disabled ? "0.5" : "1";
        }

        nameInput.addEventListener("input", toggleButton);
        logoInput.addEventListener("change", toggleButton);

        // Suggest store IDs from the name ("Dirt Late Models" -> dirt_late_models_sub) until
        // a field is edited by hand. Values coming back after an error count as edited.
        const storeInputs = document.querySelectorAll(".store-id-input");
        storeInputs.forEach(function (input) {
            input.dataset.edited = input.value.trim() !== "" ? "true" : "false";
            input.addEventListener("input", function () {
                input.dataset.edited = "true";
            });
        });

        nameInput.addEventListener("input", function () {
            const slug = nameInput.value.trim().toLowerCase()
                .replace(/[^a-z0-9]+/g, "_")
                .replace(/^_+|_+$/g, "");

            storeInputs.forEach(function (input) {
                if (input.dataset.edited === "true") return;
                input.value = slug ? slug + input.dataset.suffix : "";
            });
        });
    });
</script>

@model RevUpIQ.Admin.Models.Division.DivisionDto
@using RevUpIQ.Admin.Models.Divisions

@{
    var bg = ViewData["DivisionBackground"] as DivisionBackground;
}

<div class="division-details">

    <div class="division-details-body">

        <p class="division-section-hint">
            Status: <strong>@(Model!.IsActive ? "Active" : "Inactive")</strong>.
            Deactivating preserves the division and its data. You can reactivate it at any time.
        </p>

        <div class="division-main">

        <section class="division-section">
            <h2 class="division-section-title">Icons</h2>
            <p class="division-section-hint">
                Drag an image onto a card, or use its button. It uploads straight away. PNG, JPG or WebP.
            </p>

            <div class="division-icon-grid">

                <div class="division-icon-card">
                    <div class="division-icon-preview">
                        @if (!string.IsNullOrWhiteSpace(Model?.LogoUrl))
                        {
                            <img src="@Model.LogoUrl" alt="Division logo" />
                        }
                        else
                        {
                            <span>No logo yet<br />Drag an image here</span>
                        }
                    </div>
                    <h3>Division Logo</h3>
                    <p>Shown in the app's division menu and in this admin panel.</p>
                    <label class="admin-button division-upload-button">
                        @(string.IsNullOrWhiteSpace(Model?.LogoUrl) ? "Upload Logo" : "Change Logo")
                        <input type="file"
                               accept=".png,.jpg,.jpeg,.webp"
                               data-icon-kind="logo"
                               hidden />
                    </label>
                </div>

                <div class="division-icon-card">
                    <div class="division-icon-preview">
                        @if (!string.IsNullOrWhiteSpace(Model?.PurchaseIconUrl))
                        {
                            <img src="@Model.PurchaseIconUrl" alt="Purchase page icon" />
                        }
                        else
                        {
                            <span>No icon yet<br />Drag an image here</span>
                        }
                    </div>
                    <h3>Purchase Page Icon</h3>
                    <p>Shown on the app's purchase page. If empty, the app uses its default artwork.</p>
                    <label class="admin-button division-upload-button">
                        @(string.IsNullOrWhiteSpace(Model?.PurchaseIconUrl) ? "Upload Purchase Icon" : "Change Purchase Icon")
                        <input type="file"
                               accept=".png,.jpg,.jpeg,.webp"
                               data-icon-kind="purchase"
                               hidden />
                    </label>
                </div>

            </div>
        </section>

        <section class="division-section" id="store-ids">

            @if (TempData["StoreIdsMessage"] is string storeIdsMessage)
            {
                <div class="division-store-message ok" role="status">@storeIdsMessage</div>
            }
            @if (TempData["StoreIdsError"] is string storeIdsError)
            {
                <div class="division-store-message error" role="alert">@storeIdsError</div>
            }

            @{
                var storeIds = new[]
                {
                    ("Google Play", "Annual subscription", Model!.GoogleProductId),
                    ("App Store", "Annual", Model.AppleProductIdAnnual),
                };
            }

            <div class="division-store-card">
                <div class="division-store-card-header">
                    <div>
                        <h2 class="division-section-title">
                            Store IDs
                            <span class="division-store-lock" title="Edit Store IDs asks you to confirm every change">
                                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                                    <path fill="currentColor" d="M4 7V5a4 4 0 1 1 8 0v2h.5A1.5 1.5 0 0 1 14 8.5v6A1.5 1.5 0 0 1 12.5 16h-9A1.5 1.5 0 0 1 2 14.5v-6A1.5 1.5 0 0 1 3.5 7H4Zm2 0h4V5a2 2 0 1 0-4 0v2Z" />
                                </svg>
                                Locked
                            </span>
                        </h2>
                        <p class="division-section-hint">The subscription the app sells for this division.</p>
                    </div>

                    <button id="openStoreIds" type="button" class="admin-button">
                        Edit Store IDs
                    </button>
                </div>

                <dl class="division-store-values">
                    @foreach (var (store, plan, value) in storeIds)
                    {
                        <div class="division-store-row">
                            <dt>
                                <span class="division-store-name">@store</span>
                                <span class="division-store-plan">@plan</span>
                            </dt>
                            <dd>
                                @if (string.IsNullOrWhiteSpace(value))
                                {
                                    <span class="division-store-id is-empty">Not set</span>
                                }
                                else
                                {
                                    <code class="division-store-id">@value</code>
                                }
                            </dd>
                        </div>
                    }
                </dl>
            </div>
        </section>

        </div>

        <section class="division-background">
            <h2 class="division-section-title">Background</h2>

            <div class="division-background-preview">
                @if (bg != null && !string.IsNullOrWhiteSpace(bg.Background_Url))
                {
                    <img src="@bg.Background_Url" alt="Division background" />
                }
            </div>

            <label class="admin-button division-upload-button">
                Upload Background
                <input type="file"
                       id="divisionBackgroundInput"
                       accept="image/*"
                       hidden />
            </label>
        </section>

    </div>

</div>


<div id="editModal" class="division-modal">
    <div class="division-modal-box">

        <button id="closeEdit" type="button" class="division-modal-close" aria-label="Close">
            ✕
        </button>

        <h2 class="division-modal-title">Rename Division</h2>

        <form asp-controller="Divisions"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data"
              class="division-modal-form">

            <input type="hidden" name="Id" value="@Model?.Id" />

            <label for="divisionNameInput">Division name</label>
            <input type="text"
                   id="divisionNameInput"
                   name="Name"
                   value="@Model?.Name"
                   class="admin-input"
                   required />

            <p class="division-modal-hint">
                To change the logo or purchase page icon, use the buttons on the page.
            </p>

            <button type="submit" class="admin-button">
                Save Name
            </button>
        </form>
    </div>
</div>


<div id="storeIdsModal" class="division-modal">
    <div class="division-modal-box">

        <button id="closeStoreIds" type="button" class="division-modal-close" aria-label="Close">
            ✕
        </button>

        <h2 class="division-modal-title">Edit Store IDs</h2>

        <p class="division-modal-hint">
            Each ID must match Google Play Console (one subscription with the base plan
            "yearly-plan") or App Store Connect. Leave a field empty if that product doesn't
            exist yet. You'll be asked to confirm before anything is saved.
        </p>

        <form asp-controller="Divisions"
              asp-action="UpdateStoreIds"
              method="post"
              id="storeIdsForm"
              class="division-store-form"
              data-division-name="@Model.Name">

            <input type="hidden" name="id" value="@Model.Id" />

            <label for="googleProductIdInput">Google Play subscription ID</label>
            <input type="text"
                   id="googleProductIdInput"
                   name="googleProductId"
                   value="@Model.GoogleProductId"
                   class="admin-input"
                   placeholder="e.g. pavement_sub"
                   autocomplete="off" />

            <label for="appleProductIdAnnualInput">App Store annual product ID</label>
            <input type="text"
                   id="appleProductIdAnnualInput"
                   name="appleProductIdAnnual"
                   value="@Model.AppleProductIdAnnual"
                   class="admin-input"
                   placeholder="e.g. pavement_annual"
                   autocomplete="off" />

            <button type="submit" class="admin-button">
                Save Store IDs
            </button>
        </form>
    </div>
</div>

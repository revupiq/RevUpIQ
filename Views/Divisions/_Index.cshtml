@model List<RevUpIQ.Admin.Models.Division.DivisionDto>

<h1 class="division-title">Divisions</h1>

@{
    // Same order players see in the app: lowest sort_index first
    var ordered = Model.OrderBy(x => x.SortIndex).ThenBy(x => x.Id).ToList();
    var hasTies = ordered.GroupBy(x => x.SortIndex).Any(g => g.Count() > 1);
    var position = 0;
}

@Html.AntiForgeryToken()

<p class="division-order-help">
    Drag a division to change the order players see. Number 1 is shown first in the app.
</p>

@if (hasTies)
{
    <p class="division-order-warning">
        Some divisions share the same order position, so players may see them in an arbitrary order.
        Drag any division (or use the arrows) and the full order will be saved.
    </p>
}

<div class="admin-page-center">
    <div class="division-grid" id="divisionGrid">

@foreach (var d in ordered)
{
    position++;
    <a asp-controller="Divisions"
       asp-action="Details"
       asp-route-id="@d.Id"
       class="division-link"
       data-division-id="@d.Id"
       draggable="true">

        <div class="admin-card-small division-card"
             data-id="@d.Id">

            <span class="division-order-badge" title="Order shown to players">@position</span>

            <div class="division-sort-controls">
                <button type="button"
                        class="division-sort-button"
                        data-dir="LEFT">
                    ◀
                </button>

                <button type="button"
                        class="division-sort-button"
                        data-dir="RIGHT">
                    ▶
                </button>
            </div>

            <div class="division-content">
                @if (!string.IsNullOrWhiteSpace(d.LogoUrl))
                {
                    <img src="@d.LogoUrl"
                         class="division-logo" />
                }

                <span class="division-name">
                    @d.Name
                </span>
                @if (!d.IsActive)
                {
                    <span class="division-status">Inactive</span>
                }
            </div>

        </div>
    </a>
}


<a asp-controller="Divisions"
   asp-action="Create"
   draggable="false"
   class="admin-card-small division-create-card">
    + Add New Division
</a>

    </div>
</div>

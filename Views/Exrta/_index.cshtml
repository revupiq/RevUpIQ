@* Dashboard cards; each shows only for accounts that can open its section (AdminAccess) *@
@if (User.IsOwner() || new[] { "sponsor_bar", "notification_bar", "suggestions", "sponsor_requests", "how_to_play", "app_settings", "faqs", "push", "comments" }.Any(User.CanAccess))
{
<h1 style="text-align:center; margin-top:20px;">Extra</h1>
}

<div class="admin-page-center" style="
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(300px, 300px));
        gap:20px;
        justify-content:center;
        margin-top:40px;
     ">

    @if (User.CanAccess("sponsor_bar"))
    {
    <a href="/SponsorBar" class="admin-card-small"
        style="width:300px; display:flex; justify-content:center; align-items:center; text-decoration:none;">
        Sponsor Bar
    </a>
    }

    @if (User.CanAccess("notification_bar"))
    {
    <a asp-controller="NotificationBar" asp-action="Index" class="admin-card-small"
        style="width:300px; display:flex; justify-content:center; align-items:center; text-decoration:none;">
        Notification Bar
    </a>
    }



    @if (User.CanAccess("suggestions"))
    {
    <a asp-controller="UsersSuggestion" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
        position:relative;
">
        User Suggestion
        <span class="admin-card-badge" data-new-count="suggestions" hidden></span>
    </a>
    }


    @if (User.CanAccess("sponsor_requests"))
    {
    <a asp-controller="SponsorsRequests" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
        position:relative;
   ">
        Sponsors Requests
        <span class="admin-card-badge" data-new-count="sponsorRequests" hidden></span>
    </a>
    }
    @if (User.CanAccess("how_to_play"))
    {
    <a asp-controller="GameHowToVideos" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
   ">
        How To Play
    </a>
    }
    @if (User.CanAccess("app_settings"))
    {
    <a asp-controller="DefaultCover" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
   ">
        App Settings
    </a>
    }
    @if (User.CanAccess("faqs"))
    {
    <a asp-controller="Faqs" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
   ">
        FAQs
    </a>
    }
    @if (User.CanAccess("push"))
    {
    <a asp-controller="PushMessages" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
   ">
        Push Notifications
    </a>
    }
    @if (User.CanAccess("comments"))
    {
    <a asp-controller="Comments" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
        position:relative;
   ">
        Racing Memories
        <span class="admin-card-badge" data-new-count="reportedComments" hidden></span>
    </a>
    }
    @if (User.IsOwner())
    {
    <a asp-controller="AdminUsers" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
   ">
        Admin Users
    </a>
    }
</div>

<script>
    // "New" badges: submissions since this browser last opened each page. A count that
    // couldn't be loaded leaves its badge hidden.
    fetch('/Home/NewSubmissionCounts', { cache: 'no-store' })
        .then(r => r.ok ? r.json() : null)
        .then(counts => {
            if (!counts) return;
            document.querySelectorAll('[data-new-count]').forEach(badge => {
                const n = counts[badge.dataset.newCount];
                if (typeof n !== 'number' || n <= 0) return;
                const reported = badge.dataset.newCount === 'reportedComments';
                badge.textContent = (n > 99 ? '99+' : n) + (reported ? ' reported' : ' new');
                badge.title = reported ? n + ' reported comments to review' : n + ' new since you last opened this page';
                badge.hidden = false;
            });
        })
        .catch(() => { });
</script>
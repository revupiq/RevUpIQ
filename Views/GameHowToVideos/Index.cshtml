@{
    ViewData["Title"] = "How To Play";
    var games = ((string Key, string Title)[])ViewBag.Games;
}

<link rel="stylesheet" href="~/css/how-to-play.css" />

<div class="how-to-play-page">
    <h2 class="how-to-play-title">How To Play</h2>

    @Html.AntiForgeryToken()

    <div id="gameHowToStatus" class="game-howto-banner">Loading…</div>

    <div class="how-to-play-box" id="gameHowToBox" style="display:none;">
        <form class="how-to-play-form" id="gameHowToForm" novalidate>
            <div class="how-to-play-field">
                <label class="how-to-play-label" for="gameSelect">Game</label>
                <select id="gameSelect" class="how-to-play-input">
                    @foreach (var game in games)
                    {
                        <option value="@game.Key">@game.Title</option>
                    }
                </select>
            </div>

            <div class="how-to-play-field">
                <label class="how-to-play-label" for="video">Video URL</label>
                <input id="video" name="videoLink" type="url" maxlength="2048"
                       class="how-to-play-input"
                       placeholder="https://www.youtube.com/watch?v=…" />
                <span class="game-howto-field-hint">
                    Full https:// links only. YouTube plays inside the app; other links open externally.
                    Leave empty to show &ldquo;Video walkthrough coming soon.&rdquo;
                </span>
            </div>

            <div class="how-to-play-field">
                <label class="how-to-play-label" for="instr">Instructions</label>
                <textarea id="instr" name="instructions" maxlength="10000" class="how-to-play-textarea"></textarea>
            </div>

            <div class="how-to-play-field">
                <label class="how-to-play-label" for="scoring">Scoring and game limits</label>
                <textarea id="scoring" name="scoringText" maxlength="10000" class="how-to-play-textarea"></textarea>
            </div>

            <div class="how-to-play-field">
                <label class="how-to-play-label" for="example">Example</label>
                <textarea id="example" name="exampleText" maxlength="10000" class="how-to-play-textarea"></textarea>
                <span class="game-howto-field-hint">
                    Empty written-help fields use the app&rsquo;s default instructions.
                </span>
            </div>

            <div class="game-howto-footer">
                <span class="game-howto-updated" data-updated>Last updated: —</span>
                <span class="game-howto-save-status" data-status role="status"></span>
                <button type="submit" class="how-to-play-save">Save</button>
            </div>
        </form>
    </div>
</div>

<style>
    .game-howto-field-hint { font-size: 12px; opacity: .7; }

    .game-howto-banner {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid var(--mid-dark-blue);
        background: var(--dark-blue);
    }

    .game-howto-banner.error { border-color: #c0392b; color: #ffb3b3; }

    .game-howto-footer {
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 16px;
        flex-wrap: wrap;
    }

    .game-howto-updated { margin-right: auto; font-size: 13px; opacity: .7; }
    .game-howto-save-status { font-weight: 700; }
    .game-howto-save-status.ok { color: #2ecc71; }
    .game-howto-save-status.err { color: #ff6b6b; }
    .how-to-play-save:disabled { opacity: .6; cursor: default; transform: none; }
</style>

<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const banner = document.getElementById('gameHowToStatus');
    const box = document.getElementById('gameHowToBox');
    const form = document.getElementById('gameHowToForm');
    const select = document.getElementById('gameSelect');
    const saveBtn = form.querySelector('button[type=submit]');

    let games = {};   // gameType -> row from the server

    function formatDate(value) {
        if (!value) return 'Last updated: never';
        const d = new Date(value);
        return 'Last updated: ' + (isNaN(d) ? '—' : d.toLocaleString());
    }

    function setStatus(text, cls) {
        const el = form.querySelector('[data-status]');
        el.textContent = text;
        el.className = 'game-howto-save-status' + (cls ? ' ' + cls : '');
    }

    function validUrl(value) {
        if (!value) return true;
        if (/\s/.test(value)) return false;
        try {
            const u = new URL(value);
            return u.protocol === 'https:' && !!u.hostname;
        } catch { return false; }
    }

    function showGame(key) {
        const g = games[key];
        if (!g) return;

        form.elements.videoLink.value = g.videoLink || '';
        form.elements.instructions.value = g.instructions || '';
        form.elements.scoringText.value = g.scoringText || '';
        form.elements.exampleText.value = g.exampleText || '';
        form.querySelector('[data-updated]').textContent = formatDate(g.updatedAt);

        saveBtn.disabled = !g.exists;
        setStatus(g.exists ? '' : 'No row found in game_how_to_play for this game.', g.exists ? '' : 'err');

        try { history.replaceState(null, '', '?game=' + encodeURIComponent(key)); } catch { }
    }

    async function load() {
        try {
            const res = await fetch('@Url.Action("Data", "GameHowToVideos")');
            const data = await res.json().catch(() => null);

            if (!res.ok) {
                throw new Error((data && data.error) || 'Could not load the how-to videos.');
            }

            data.forEach(g => games[g.gameType] = g);

            const wanted = new URLSearchParams(location.search).get('game');
            if (wanted && games[wanted]) select.value = wanted;

            showGame(select.value);

            banner.style.display = 'none';
            box.style.display = 'block';
        } catch (err) {
            banner.textContent = err.message;
            banner.classList.add('error');

            // Keep the form visible so the page is usable once the table exists
            saveBtn.disabled = true;
            box.style.display = 'block';
        }
    }

    select.addEventListener('change', () => showGame(select.value));

    form.addEventListener('submit', async e => {
        e.preventDefault();

        const key = select.value;
        const videoLink = form.elements.videoLink.value.trim();

        if (!validUrl(videoLink)) {
            setStatus('Video URL must be a full https:// link.', 'err');
            return;
        }

        saveBtn.disabled = true;
        select.disabled = true;
        setStatus('Saving…', '');

        try {
            const body = {
                gameType: key,
                videoLink: videoLink || null,
                instructions: form.elements.instructions.value,
                scoringText: form.elements.scoringText.value,
                exampleText: form.elements.exampleText.value
            };

            const res = await fetch('@Url.Action("Save", "GameHowToVideos")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(body)
            });

            const data = await res.json().catch(() => null);

            if (!res.ok) {
                throw new Error((data && data.error) || 'Saving failed.');
            }

            games[key] = Object.assign(games[key], {
                videoLink: videoLink || null,
                instructions: body.instructions,
                scoringText: body.scoringText,
                exampleText: body.exampleText,
                updatedAt: data.updatedAt
            });

            form.elements.videoLink.value = videoLink;
            form.querySelector('[data-updated]').textContent = formatDate(data.updatedAt);
            setStatus('Saved ✓', 'ok');
            setTimeout(() => setStatus('', ''), 3000);
        } catch (err) {
            setStatus(err.message, 'err');
        } finally {
            saveBtn.disabled = false;
            select.disabled = false;
        }
    });

    load();
})();
</script>

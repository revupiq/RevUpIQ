@using RevUpIQ.Admin.Models.MiniGames
@{
    var game = ViewData["GameData"] as PhotoGuessDailyDto;
    var hasImage = !string.IsNullOrWhiteSpace(game?.ImageUrl);
}

<div class="trivia-game">

@if (game == null)
{
    <div class="trivia-error">No Photo Guess Data Loaded</div>
}
else
{
    <form class="trivia-edit"
          method="post"
          action="/MiniGames/UpdatePhotoGuess"
          id="photoGuessEditForm"
          enctype="multipart/form-data">

        <input type="hidden" name="id" value="@game.Id" />

        <!-- QUESTION -->
        <textarea class="edit-question"
                  name="Question"
                  rows="3">@game.Question</textarea>

        <!-- IMAGE (without one, a full-width area to add it) -->
        <div class="photo-upload"
             style="@(hasImage ? "" : "width:100%; max-width:700px; display:flex; flex-direction:column; gap:12px;")">

            @if (!hasImage)
            {
                @* e.g. imported from a CSV without an image_url; the app skips it until one is added *@
                <div class="photo-unpublished" id="photoUnpublished" role="status">
                    <strong>Unpublished — no image.</strong>
                    Players won't see this question until you add one.
                </div>
            }

            <div id="photoImageFrame"
                 class="photo-frame-3x2 @(hasImage ? "" : "photo-image-frame")"
                 data-has-image="@(hasImage ? "true" : "false")">

                <img id="photoPreview"
                     src="@(hasImage ? game.ImageUrl : "")"
                     alt="Preview"
                     style="@(hasImage ? "display:block;" : "display:none;")" />

                <span class="photo-image-placeholder"
                      style="@(hasImage ? "display:none;" : "")">
                    @(hasImage ? "Click image to change" : "Click here to add the image")
                </span>

            </div>

            <div class="photo-credit-line" id="photoCreditPreview"></div>
            <div class="photo-frame-note">Shown like this in the app: a 3:2 frame. 3:2 photos fit whole; others are trimmed at the edges.</div>

            <input type="file"
                   id="imageInput"
                   name="ImageFile"
                   accept="image/*"
                   style="display:none;" />

        </div>

        @await Html.PartialAsync("~/Views/MiniGames/PhotoGuess/_PhotoCreditField.cshtml", game.PhotoCredit)

        <div class="trivia-options">

            <div class="option-box correct">
                <div class="option-label">CORRECT ANSWER</div>
                <input class="edit-option correct"
                       type="text"
                       name="RealAnswer"
                       value="@game.RealAnswer" />
            </div>

            <div class="option-box">
                <div class="option-label">OPTION A</div>
                <input class="edit-option"
                       type="text"
                       name="Answer1"
                       value="@game.Answer1" />
            </div>

            <div class="option-box">
                <div class="option-label">OPTION B</div>
                <input class="edit-option"
                       type="text"
                       name="Answer2"
                       value="@game.Answer2" />
            </div>

            <div class="option-box">
                <div class="option-label">OPTION C</div>
                <input class="edit-option"
                       type="text"
                       name="Answer3"
                       value="@game.Answer3" />
            </div>

        </div>

        @await Html.PartialAsync("~/Views/MiniGames/_FunFactField.cshtml", game.FunFact)

        <button type="submit"
                class="admin-button save-btn"
                disabled>
            Save Changes
        </button>

    </form>
}

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const form = document.getElementById("photoGuessEditForm");
    if (!form) return;

    const saveBtn = form.querySelector(".save-btn");
    const inputs = form.querySelectorAll("input:not([type='hidden']):not([type='file']):not([data-optional]), textarea:not([data-optional])");
    const imageInput = document.getElementById("imageInput");
    const frame = document.getElementById("photoImageFrame");
    const preview = document.getElementById("photoPreview");
    const placeholder = frame.querySelector(".photo-image-placeholder");

    // The image isn't required to save: a question without one stays unpublished
    // until an image is added
    function validateForm() {
        let isValid = true;

        inputs.forEach(function (el) {
            if (!el.value.trim()) isValid = false;
        });

        saveBtn.disabled = !isValid;
        saveBtn.style.opacity = isValid ? "1" : "0.5";
        saveBtn.style.cursor = isValid ? "pointer" : "not-allowed";
    }

    inputs.forEach(el => el.addEventListener("input", validateForm));

    frame.addEventListener("click", function () {
        imageInput.click();
    });

    imageInput.addEventListener("change", function () {

        if (imageInput.files && imageInput.files[0]) {

            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = "block";
                placeholder.style.display = "none";
                frame.dataset.hasImage = "true";

                const unpublished = document.getElementById("photoUnpublished");
                if (unpublished) unpublished.textContent = "Image chosen — the question is published when you save.";

                validateForm();
            };

            reader.readAsDataURL(imageInput.files[0]);

        } else {
            validateForm();
        }

    });

    validateForm();

    form.addEventListener("submit", function (e) {
        e.preventDefault();

        const formData = new FormData(form);

        fetch(form.action, {
            method: "POST",
            body: formData
        })
        .then(function (res) {
            if (res.ok) {
                window.history.back();
            } else {
                alert("Error saving photo guess.");
            }
        })
        .catch(function () {
            alert("Error saving photo guess.");
        });
    });

});
</script>

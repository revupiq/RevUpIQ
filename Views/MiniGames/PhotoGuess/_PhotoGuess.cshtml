@using RevUpIQ.Admin.Models.MiniGames
@model PhotoGuessDailyDto

<div class="trivia-game">

    @if (Model == null)
    {
        <div class="trivia-error">
            No photo game found for this day.
        </div>
    }
    else
    {
        <!-- QUESTION -->
        <div class="trivia-question">
            @Model.Question
        </div>

        @if (string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            @* The app skips a question without an image, e.g. one imported without image_url *@
            <div class="photo-unpublished-frame">
                <strong>Unpublished — no image</strong>
                <span>Players won't see this question until you add an image with Edit Mini Game.</span>
            </div>
        }
        else
        {
            <!-- IMAGE (3:2, cropped to fill like the app) and its credit -->
            <div style="width: 420px; max-width: 100%; margin: 0 auto 24px;">
                <div style="
                    width: 100%;
                    aspect-ratio: 3 / 2;
                    border-radius: 16px;
                    overflow: hidden;
                    box-shadow: 0 6px 22px rgba(0,0,0,.5);
                    background: rgba(0,0,0,.35);
                ">
                    <img src="@Model.ImageUrl" style="
                             width: 100%;
                             height: 100%;
                             object-fit: cover;
                         " />
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.PhotoCredit))
                {
                    <div class="photo-credit-line" style="margin-top: 4px;">@Model.PhotoCredit</div>
                }
            </div>
        }

        <div class="trivia-options">
            <button class="trivia-option correct">@Model.RealAnswer</button>
            <button class="trivia-option">@Model.Answer1</button>
            <button class="trivia-option">@Model.Answer2</button>
            <button class="trivia-option">@Model.Answer3</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.FunFact))
        {
            <div class="mini-game-fun-fact">
                <span class="mini-game-fun-fact-label">Fun Fact</span>
                <span class="mini-game-fun-fact-text">@Model.FunFact</span>
            </div>
        }
    }

</div>
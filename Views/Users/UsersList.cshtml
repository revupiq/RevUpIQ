@using RevUpIQ.Admin.Models.Users
@model UsersListViewModel

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Users";
}

<h1 style="text-align:center; margin-top:20px;">Users</h1>

<div class="users-container users-list-container">
    <div class="users-toolbar">
        <input type="text"
               id="userSearch"
               placeholder="Search by email or phone"
               onkeyup="filterUsers()" />

        <select id="profileFilter" onchange="onProfileFilterChange()">
            <option value="all" selected="@(Model.Profile == "all")">All users</option>
            <option value="complete" selected="@(Model.Profile == "complete")">Registration complete</option>
            <option value="incomplete" selected="@(Model.Profile == "incomplete")">Registration incomplete</option>
            <option value="unverified" selected="@(Model.Profile == "unverified")">Unverified (deleted after 24h)</option>
        </select>

        <button id="openCreateUser" type="button" class="admin-button">
            Create User
        </button>
    </div>

    <div id="createUserMessage" class="division-store-message ok users-create-message" role="status" hidden></div>

    <div class="user-header">
        <span>Username</span>
        <span>Email</span>
        <span>Phone</span>
        <span>Created</span>
        <span>Last Login (UTC−7)</span>
        <span>Registration</span>
        <span>Status</span>
        <span></span>
    </div>

    <div id="normalWrap">
        <div id="normalList">
            @foreach (var user in Model.Users)
            {
                <div class="user-row"
                     onclick="location.href='@Url.Action("UserDetails", new { id = user.Id })'">
                    <span>@(string.IsNullOrWhiteSpace(user.Username) ? "—" : user.Username)</span>
                    <span>@(user.Email ?? "—")</span>
                    <span>@(user.Phone ?? "—")</span>
                    <span>@DisplayTime.Format(user.Created_At)</span>
                    <span>@DisplayTime.Format(user.Last_Sign_In_At, "Never")</span>
                    <span>
                        <span class="registration-badge registration-@user.Registration.ToLowerInvariant().Replace(' ', '-')">
                            @user.Registration
                        </span>
                    </span>
                    <span>
                        <span class="status-badge @SubscriptionStatus.CssClass(user.SubscriptionStatus)">
                            @user.SubscriptionStatus
                        </span>
                    </span>
                    <span>
                        <button type="button" class="user-delete-btn"
                                data-id="@user.Id" data-email="@(user.Email ?? user.Phone)"
                                onclick="deleteUser(event, this)">Delete</button>
                    </span>
                </div>
            }
        </div>

        <div class="users-pagination">
            @if (Model.Page > 1)
            {
                <a asp-action="UsersList"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-perPage="@Model.PerPage"
                   asp-route-profile="@Model.Profile"
                   class="page-link page-link-prev">« Previous</a>
            }

            <span class="page-info">Page @Model.Page</span>

            @if (Model.HasNextPage)
            {
                <a asp-action="UsersList"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-perPage="@Model.PerPage"
                   asp-route-profile="@Model.Profile"
                   class="page-link page-link-next">Next »</a>
            }
        </div>
    </div>

    <div id="searchWrap" style="display:none;">
        <div id="searchResults"></div>

        <div class="users-pagination">
            <span class="page-info" id="searchInfo"></span>
        </div>
    </div>
</div>

<p class="users-time-note">All timestamps are shown in UTC−7.</p>

@await Html.PartialAsync("_DeleteUserModal")
@await Html.PartialAsync("_CreateUserModal")

<script>
let usersSearchRequest;
async function filterUsers() {
    const query = document.getElementById("userSearch").value.trim();
    usersSearchRequest?.abort();
    const request = new AbortController();
    usersSearchRequest = request;

    if (!query) {
        document.getElementById("normalWrap").style.display = "block";
        document.getElementById("searchWrap").style.display = "none";
        return;
    }

    const profile = document.getElementById("profileFilter").value;

    let users;
    try {
        const res = await fetch(
            `/Users/SearchUsers?q=${encodeURIComponent(query)}&profile=${profile}`,
            { signal: request.signal });
        if (!res.ok) throw new Error("Unable to search users.");
        users = await res.json();
    } catch (error) {
        if (error.name !== "AbortError") console.error(error);
        return;
    }
    if (usersSearchRequest !== request) return;

    document.getElementById("normalWrap").style.display = "none";
    document.getElementById("searchWrap").style.display = "block";

    const container = document.getElementById("searchResults");
    container.innerHTML = "";

    users.forEach(u => {
        const row = document.createElement("div");
        row.className = "user-row";
        row.onclick = () => location.href = `/Users/UserDetails/${u.id}`;

        const addCell = text => {
            const cell = document.createElement("span");
            cell.textContent = text;
            row.appendChild(cell);
        };

        addCell(u.username?.trim() || "—");
        addCell(u.email ?? "—");
        addCell(u.phone ?? "—");
        addCell(AdminTime.format(u.created_At));
        addCell(AdminTime.format(u.last_Sign_In_At, "Never"));

        const badgeCell = document.createElement("span");
        const badge = document.createElement("span");
        const registration = u.registration || "Unverified";
        badge.className = "registration-badge registration-" + registration.toLowerCase().replace(/\s+/g, "-");
        badge.textContent = registration;
        badgeCell.appendChild(badge);
        row.appendChild(badgeCell);

        const statusCell = document.createElement("span");
        const status = document.createElement("span");
        const statusText = u.subscriptionStatus || "Inactive";
        status.className = "status-badge status-" + statusText.trim().toLowerCase().replace(/\s+/g, "-");
        status.textContent = statusText;
        statusCell.appendChild(status);
        row.appendChild(statusCell);

        const btnCell = document.createElement("span");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "user-delete-btn";
        btn.textContent = "Delete";
        btn.dataset.id = u.id;
        btn.dataset.email = u.email || u.phone || "";
        btn.onclick = e => deleteUser(e, btn);
        btnCell.appendChild(btn);
        row.appendChild(btnCell);

        container.appendChild(row);
    });

    document.getElementById("searchInfo").innerText =
        `Results: ${users.length}`;
}

function onProfileFilterChange() {
    const profile = document.getElementById("profileFilter").value;
    const query = document.getElementById("userSearch").value.trim();

    if (query) {
        filterUsers();
        return;
    }

    location.href = `@Url.Action("UsersList")?profile=${profile}`;
}

function deleteUser(event, btn) {
    event.stopPropagation();

    openDeleteUserModal(
        { id: btn.dataset.id, label: btn.dataset.email || btn.dataset.id },
        () => btn.closest(".user-row").remove()
    );
}
</script>

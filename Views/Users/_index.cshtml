@* Dashboard cards; each shows only for accounts that can open its section (AdminAccess) *@
@if (User.CanAccess("leaderboard") || User.CanAccess("users") || User.CanAccess("leagues") || User.CanAccess("support"))
{
<h1 style="text-align:center; margin-top:20px;">Users</h1>

<div class="admin-page-center" style="
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(300px, 300px));
        gap:20px;
        justify-content:center;
        margin-top:40px;
     ">

    @if (User.CanAccess("leaderboard"))
    {
    <a href="/Leaderboard" class="admin-card-small" style="
    width:300px;
    display:flex;
    justify-content:center;
    align-items:center;
    text-decoration:none;
">
        Leaderboard
    </a>
    }

    @if (User.CanAccess("users"))
    {
    <a asp-controller="Users" asp-action="UsersList" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
   ">
        Users List
    </a>
    }

    @if (User.CanAccess("leagues"))
    {
    <a asp-controller="Leagues" asp-action="Index" class="admin-card-small" style="
        width:300px;
        display:flex;
        justify-content:center;
        align-items:center;
        text-decoration:none;
   ">
        Leagues
    </a>
    }
    @if (User.CanAccess("support"))
    {
    <a asp-controller="Support" asp-action="Index" class="admin-card-small" style="
    width:300px;
    display:flex;
    justify-content:center;
    align-items:center;
    text-decoration:none;">
        Support
    </a>
    }
</div>
}
